# Copy to .env.local for local development.
# In production these are configured in the Vercel project settings.

# --- Supabase (required) ---
# Project URL and anonymous (publishable) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER ONLY - never prefix with NEXT_PUBLIC.
# Used by /api/auth/delete-account and /api/admin/init.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email: Resend (Espace Client notifications) ---
RESEND_API_KEY=re_your_key
# Optional fallback key.
RESEND_API_KEY_2=

# --- One-time admin bootstrap (/api/admin/init) ---
# Set to a long random string, call the route once, then remove the route/var.
ADMIN_SETUP_KEY=

# --- Meta (Facebook/Instagram/WhatsApp) webhooks (/api/webhooks/meta) ---
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# --- SEO (optional) ---
# Google Search Console verification token (bare token, not the full meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Canal vers Atelier Maths (lien simple, pas de compte partagé pour l'instant) ---
# URL racine du déploiement Vercel d'atelier-maths (sans slash final). Vide =
# le lien n'apparaît pas dans le footer (components/footer.tsx). Valeur réelle
# actuelle (projet Vercel `formations`, voir atelier-maths/README.md) :
NEXT_PUBLIC_ATELIER_MATHS_URL=https://formations-beta-inky.vercel.app
